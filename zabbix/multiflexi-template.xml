    <templates>
        <template>
            <uuid>bd4f272898794e47b0adb0444b946708</uuid>
            <template>MultiFlexi by Zabbix agent</template>
            <name>MultiFlexi by Zabbix agent</name>
            <description>Template for monitoring MultiFlexi job scheduler and automation framework.

This template monitors:
- MultiFlexi system status and services
- Job execution statistics and status
- Company and application metrics
- RunTemplate discovery and monitoring

Requirements:
- MultiFlexi 1.0 or higher
- multiflexi-cli installed and in PATH
- multiflexi-zabbix package installed
- Zabbix agent 2 with UserParameter support

Documentation: https://multiflexi.readthedocs.io/en/latest/zabbix.html

Template Version: 1.0.0
Author: VitexSoftware
License: MIT</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items>
                <!-- System Status Items -->
                <item>
                    <uuid>67c47e8027ac4b67a299b5fc2e48ae3e</uuid>
                    <name>MultiFlexi: System Status</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>multiflexi.appstatus</key>
                    <delay>5m</delay>
                    <history>7d</history>
                    <trends>30d</trends>
                    <value_type>TEXT</value_type>
                    <description>MultiFlexi system status in JSON format including database, services, and entity counts.</description>
                </item>
                <item>
                    <uuid>48fd9c78482a4a2da17a777fc6c21ffa</uuid>
                    <name>MultiFlexi: Database Host</name>
                    <type>DEPENDENT</type>
                    <key>multiflexi.db.host</key>
                    <history>7d</history>
                    <trends>0</trends>
                    <value_type>CHAR</value_type>
                    <description>Database hostname from system status</description>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.db_host</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>multiflexi.appstatus</key>
                    </master_item>
                </item>
                <item>
                    <uuid>c2f52b5255ed4eb3a8a6c58b64f4313d</uuid>
                    <name>MultiFlexi: Total Applications</name>
                    <type>DEPENDENT</type>
                    <key>multiflexi.applications.total</key>
                    <history>7d</history>
                    <trends>30d</trends>
                    <value_type>UNSIGNED</value_type>
                    <description>Total number of applications registered in MultiFlexi</description>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.applications</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>multiflexi.appstatus</key>
                    </master_item>
                </item>
                <item>
                    <uuid>55495f242add4680a04827ca08a898a0</uuid>
                    <name>MultiFlexi: Total Companies</name>
                    <type>DEPENDENT</type>
                    <key>multiflexi.companies.total</key>
                    <history>7d</history>
                    <trends>30d</trends>
                    <value_type>UNSIGNED</value_type>
                    <description>Total number of companies/tenants in MultiFlexi</description>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.companies</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>multiflexi.appstatus</key>
                    </master_item>
                </item>
                <item>
                    <uuid>2faf2fd52fe3451cb0b81e70d12f1b47</uuid>
                    <name>MultiFlexi: Total RunTemplates</name>
                    <type>DEPENDENT</type>
                    <key>multiflexi.runtemplates.total</key>
                    <history>7d</history>
                    <trends>30d</trends>
                    <value_type>UNSIGNED</value_type>
                    <description>Total number of RunTemplates configured</description>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.runtemplates</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>multiflexi.appstatus</key>
                    </master_item>
                </item>
                <item>
                    <uuid>58dbfa2e222b4285b3196395aadfe67f</uuid>
                    <name>MultiFlexi: Total Jobs</name>
                    <type>DEPENDENT</type>
                    <key>multiflexi.jobs.total</key>
                    <history>7d</history>
                    <trends>30d</trends>
                    <value_type>UNSIGNED</value_type>
                    <description>Total number of jobs in database</description>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.jobs</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>multiflexi.appstatus</key>
                    </master_item>
                </item>
                <!-- Job Status Items -->
                <item>
                    <uuid>30d8079a51ef497792651f6f6756306b</uuid>
                    <name>MultiFlexi: Job Status</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>multiflexi.jobstatus</key>
                    <delay>1m</delay>
                    <history>7d</history>
                    <trends>30d</trends>
                    <value_type>TEXT</value_type>
                    <description>Job execution status summary in JSON format</description>
                </item>
                <!-- Stale Schedule Items -->
                <item>
                    <uuid>97445a4066f043648e666378c0750389</uuid>
                    <name>MultiFlexi: Stale RunTemplate Schedules</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>multiflexi.schedule.stale</key>
                    <delay>15m</delay>
                    <history>7d</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <description>Active run-templates whose next_schedule is stuck more than the tolerance window in the past (in JSON format). A non-empty list means the runtemplate has silently dropped out of CronScheduler's daily rotation - see MultiFlexi\Scheduler::initializeScheduling().</description>
                </item>
                <item>
                    <uuid>26beff18da7049cda3032e5dee169705</uuid>
                    <name>MultiFlexi: Stale RunTemplate Count</name>
                    <type>DEPENDENT</type>
                    <key>multiflexi.schedule.stale.count</key>
                    <history>7d</history>
                    <trends>30d</trends>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of active run-templates whose next_schedule is stuck in the past</description>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.count</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>multiflexi.schedule.stale</key>
                    </master_item>
                    <triggers>
                        <trigger>
                            <uuid>111c1fa6c9254238bff5a3e16f55b278</uuid>
                            <expression>last(/MultiFlexi by Zabbix agent/multiflexi.schedule.stale.count)&gt;0</expression>
                            <name>MultiFlexi: {ITEM.VALUE} RunTemplate(s) have a stale schedule</name>
                            <priority>HIGH</priority>
                            <description>One or more active RunTemplates have a next_schedule stuck in the past and have silently dropped out of the daily cron rotation - their jobs will not run again on their own.

This typically happens when a job never reaches normal completion (crash, OOM-kill, executor failure outside the standard fail path), leaving next_schedule set. Run `multiflexi-cli run-template:stale --format=json` for details, and `multiflexi-cli queue:fix` to reset the affected RunTemplates back into the schedule.</description>
                        </trigger>
                    </triggers>
                </item>
            </items>
            <discovery_rules>
                <!-- Company Discovery -->
                <discovery_rule>
                    <uuid>6ecca7125a7a43be9e2a77ef49fe0754</uuid>
                    <name>MultiFlexi: Company Discovery</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>multiflexi.company.lld</key>
                    <delay>1h</delay>
                    <lifetime>7d</lifetime>
                    <description>Discovers companies/tenants in MultiFlexi</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>55b7a00ebff341a5956cba138054a2eb</uuid>
                            <name>Company {#COMPANY_NAME}: Status</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>multiflexi.company.status[{#COMPANY_CODE}]</key>
                            <delay>5m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Status of company {#COMPANY_NAME} (1=enabled, 0=disabled)</description>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>b49aaef63f234ccbb45d6f5231b5e47c</uuid>
                            <expression>last(/MultiFlexi by Zabbix agent/multiflexi.company.status[{#COMPANY_CODE}])=0</expression>
                            <name>Company {#COMPANY_NAME} is disabled</name>
                            <priority>INFO</priority>
                            <description>Company {#COMPANY_NAME} ({#COMPANY_CODE}) has been disabled in MultiFlexi.</description>
                        </trigger_prototype>
                    </trigger_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>3cb778a5653b47dbb2b8522a2f3a87b6</uuid>
                            <name>Company {#COMPANY_NAME}: Activity</name>
                            <graph_items>
                                <graph_item>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>MultiFlexi by Zabbix agent</host>
                                        <key>multiflexi.company.status[{#COMPANY_CODE}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
                <!-- RunTemplate Discovery -->
                <discovery_rule>
                    <uuid>c543c2bc0e3746b0b14851d489081702</uuid>
                    <name>MultiFlexi: RunTemplate Discovery</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>multiflexi.runtemplate.lld</key>
                    <delay>1h</delay>
                    <lifetime>7d</lifetime>
                    <description>Discovers RunTemplates with their applications and companies</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>ce63dde02a3b4dddb032c1851187acc2</uuid>
                            <name>{#COMPANY_NAME} - {#APPNAME}: Last Execution Status</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>multiflexi.job.last_status[{#RUNTEMPLATE}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Last execution status for RunTemplate {#RUNTEMPLATE_NAME} (0=success, 1=failed, 2=running)</description>
                            <valuemap>
                                <name>MultiFlexi Job Status</name>
                            </valuemap>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>e69ffa313c2b43ae90e268a1fc0d27c0</uuid>
                            <expression>last(/MultiFlexi by Zabbix agent/multiflexi.job.last_status[{#RUNTEMPLATE}])=1</expression>
                            <name>{#COMPANY_NAME} - {#APPNAME}: Job failed</name>
                            <priority>HIGH</priority>
                            <description>RunTemplate {#RUNTEMPLATE_NAME} for {#APPNAME} in {#COMPANY_NAME} has failed.

Company: {#COMPANY_NAME} ({#COMPANY_CODE})
Application: {#APPNAME} ({#APPNAME_CODE})
Interval: {#INTERVAL}
RunTemplate ID: {#RUNTEMPLATE}</description>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
                <!-- Job Discovery -->
                <discovery_rule>
                    <uuid>3f332e8b8c894397a3695aec46e1f328</uuid>
                    <name>MultiFlexi: Job Discovery</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>multiflexi.job.lld</key>
                    <delay>30m</delay>
                    <lifetime>3d</lifetime>
                    <description>Discovers scheduled jobs and tasks</description>
                </discovery_rule>
                <!-- Action Discovery -->
                <discovery_rule>
                    <uuid>1dc6bbc73fd84012961476f160c723c2</uuid>
                    <name>MultiFlexi: Action Discovery</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>multiflexi.action.lld</key>
                    <delay>1h</delay>
                    <lifetime>7d</lifetime>
                    <description>Discovers RunTemplates with Zabbix actions configured</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>5164cbadb889429e9a5e7b46b8f56bb7</uuid>
                            <name>{#RUN_TEMPLATE_NAME}: Success Action Data</name>
                            <type>TRAP</type>
                            <key>zabbix_action[{#ZABBIX_KEY_SUCCESS}]</key>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Data sent to Zabbix on successful execution of {#RUN_TEMPLATE_NAME}</description>
                        </item_prototype>
                        <item_prototype>
                            <uuid>9af6d4ec0a174637856cef22ef433375</uuid>
                            <name>{#RUN_TEMPLATE_NAME}: Failure Action Data</name>
                            <type>TRAP</type>
                            <key>zabbix_action[{#ZABBIX_KEY_FAIL}]</key>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Data sent to Zabbix on failed execution of {#RUN_TEMPLATE_NAME}</description>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
                <!-- Credential Availability Discovery -->
                <discovery_rule>
                    <uuid>20ee95cdf4fd415682c3cb907d840295</uuid>
                    <name>MultiFlexi: Credential Availability Discovery</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>multiflexi.credential.lld</key>
                    <delay>1h</delay>
                    <lifetime>7d</lifetime>
                    <description>Discovers MultiFlexi credentials and reports their availability state. Credentials whose type implements a live check (checkableCredentialInterface) report the real checkAvailability() result; credentials without one still get flagged Misconfigured when a required field is empty.</description>
                    <filter>
                        <conditions>
                            <condition>
                                <macro>{#CREDENTIAL_TYPE}</macro>
                                <value>{$CRED.AVAILABILITY.EXCLUDE}</value>
                                <operator>NOT_MATCHES_REGEX</operator>
                                <formulaid>A</formulaid>
                            </condition>
                        </conditions>
                        <evaltype>AND_OR</evaltype>
                    </filter>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>3aa9a9eae1384b1e8fbbd0f5828a4e00</uuid>
                            <name>Credential {#CREDENTIAL_NAME}: Availability check</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>multiflexi.credential.check[{#CREDENTIAL_ID}]</key>
                            <delay>{$CRED.AVAILABILITY.INTERVAL:"{#CREDENTIAL_TYPE}"}</delay>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Full checkAvailability() result for credential {#CREDENTIAL_NAME} ({#CREDENTIAL_TYPE}) as JSON: state, message, checked_at, ttl, details. Polled once per cycle; the State/Message/Details items below are derived from this via JSONPath preprocessing so the (possibly network-bound) check only runs once.</description>
                        </item_prototype>
                        <item_prototype>
                            <uuid>6a976cc41d95499cbc49934a2233ea3a</uuid>
                            <name>Credential {#CREDENTIAL_NAME}: State</name>
                            <type>DEPENDENT</type>
                            <key>multiflexi.credential.state[{#CREDENTIAL_ID}]</key>
                            <history>7d</history>
                            <trends>30d</trends>
                            <value_type>UNSIGNED</value_type>
                            <description>Availability state of credential {#CREDENTIAL_NAME} (0=Available, 1=Degraded, 2=Unavailable, 3=Misconfigured, 4=Unknown)</description>
                            <valuemap>
                                <name>MultiFlexi Credential State</name>
                            </valuemap>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.state_code</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>multiflexi.credential.check[{#CREDENTIAL_ID}]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>41a22f0bb5e34f0eb742a2c7306c839f</uuid>
                            <name>Credential {#CREDENTIAL_NAME}: Message</name>
                            <type>DEPENDENT</type>
                            <key>multiflexi.credential.message[{#CREDENTIAL_ID}]</key>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Human-readable availability message for credential {#CREDENTIAL_NAME}</description>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.message</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>multiflexi.credential.check[{#CREDENTIAL_ID}]</key>
                            </master_item>
                        </item_prototype>
                        <item_prototype>
                            <uuid>453c2d95901541d0b4865d13d2c5c56c</uuid>
                            <name>Credential {#CREDENTIAL_NAME}: Details</name>
                            <type>DEPENDENT</type>
                            <key>multiflexi.credential.details[{#CREDENTIAL_ID}]</key>
                            <history>7d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Opaque JSON passthrough of the checkAvailability() details array for credential {#CREDENTIAL_NAME}. Field names are prototype-specific and not standardized across credential types - for troubleshooting, not alerting.</description>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.details</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <master_item>
                                <key>multiflexi.credential.check[{#CREDENTIAL_ID}]</key>
                            </master_item>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>f75dbc461233424d88033086136cf49a</uuid>
                            <expression>last(/MultiFlexi by Zabbix agent/multiflexi.credential.state[{#CREDENTIAL_ID}])=3</expression>
                            <name>Credential {#CREDENTIAL_NAME} is misconfigured</name>
                            <priority>WARNING</priority>
                            <description>Credential {#CREDENTIAL_NAME} ({#CREDENTIAL_TYPE}) in {#COMPANY_NAME} is missing required configuration and cannot be used. See the credential's Message/Details items or the MultiFlexi credential UI for which fields are missing.</description>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>79254ce98627467cbae19dd23e8914c4</uuid>
                            <expression>last(/MultiFlexi by Zabbix agent/multiflexi.credential.state[{#CREDENTIAL_ID}])=2</expression>
                            <name>Credential {#CREDENTIAL_NAME} API is unreachable</name>
                            <priority>HIGH</priority>
                            <description>Credential {#CREDENTIAL_NAME} ({#CREDENTIAL_TYPE}) in {#COMPANY_NAME} is fully configured but its endpoint could not be reached. Jobs depending on this credential will fail.</description>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>8a939597cb4849ee9c136511b279b4ab</uuid>
                            <expression>last(/MultiFlexi by Zabbix agent/multiflexi.credential.state[{#CREDENTIAL_ID}])=1</expression>
                            <name>Credential {#CREDENTIAL_NAME} is degraded</name>
                            <priority>AVERAGE</priority>
                            <description>Credential {#CREDENTIAL_NAME} ({#CREDENTIAL_TYPE}) in {#COMPANY_NAME} is reachable but impaired (e.g. remote service busy or rate-limited).</description>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
            </discovery_rules>
            <httptests>
                <httptest>
                    <uuid>e04f3ff830ff46199d9f7a8244676768</uuid>
                    <name>MultiFlexi Web Interface</name>
                    <delay>1m</delay>
                    <attempts>3</attempts>
                    <agent>Zabbix</agent>
                    <steps>
                        <step>
                            <name>Login Page</name>
                            <url>http://localhost/multiflexi/</url>
                            <status_codes>200</status_codes>
                            <no_follow_redirects>NO</no_follow_redirects>
                        </step>
                    </steps>
                </httptest>
            </httptests>
            <macros>
                <macro>
                    <macro>{$MULTIFLEXI.SUCCESS_RATE.MIN}</macro>
                    <value>80</value>
                    <description>Minimum acceptable job success rate (%)</description>
                </macro>
                <macro>
                    <macro>{$MULTIFLEXI.URL}</macro>
                    <value>http://localhost/multiflexi</value>
                    <description>MultiFlexi web interface URL</description>
                </macro>
                <macro>
                    <macro>{$CRED.AVAILABILITY.INTERVAL}</macro>
                    <value>5m</value>
                    <description>Default polling interval for credential availability checks (multiflexi.credential.check[*]). Override per credential type with a macro context, e.g. {$CRED.AVAILABILITY.INTERVAL:"RaiffeisenBank"} = 30m, for services with tight API rate limits - no template/code change needed.</description>
                </macro>
                <macro>
                    <macro>{$CRED.AVAILABILITY.EXCLUDE}</macro>
                    <value></value>
                    <description>Regex matched against {#CREDENTIAL_TYPE}; any matching credential type is excluded from Credential Availability Discovery entirely. Empty (default) excludes nothing. E.g. set to "^(RaiffeisenBank)$" to stop discovering/checking that type without touching the template.</description>
                </macro>
            </macros>
            <valuemaps>
                <valuemap>
                    <uuid>a2e3819a562a4db08ef25dbcebd3f34c</uuid>
