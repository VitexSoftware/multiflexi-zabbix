#!/bin/sh
set -e
. /usr/share/debconf/confmodule

if [ "$1" = "configure" ]; then
    db_get multiflexi-zabbix/zabbix_server || true
    ZABBIX_SERVER="$RET"
    db_get multiflexi-zabbix/zabbix_host || true
    ZABBIX_HOST="$RET"
    db_get multiflexi-zabbix/zabbix_url || true
    ZABBIX_URL="$RET"
    db_get multiflexi-zabbix/use_zabbix_sender || true
    USE_ZABBIX_SENDER="$RET"

    CONFIG_DIR="/etc/multiflexi"
    CONFIG_FILE="$CONFIG_DIR/multiflexi.env"

    if [ ! -d "$CONFIG_DIR" ]; then
        mkdir -p "$CONFIG_DIR"
    fi

    touch "$CONFIG_FILE"

    update_config() {
        key=$1
        value=$2
        if grep -q "^$key=" "$CONFIG_FILE"; then
            sed -i "s|^$key=.*|$key=$value|" "$CONFIG_FILE"
        else
            echo "$key=$value" >> "$CONFIG_FILE"
        fi
    }

    [ -n "$ZABBIX_SERVER" ] && update_config "ZABBIX_SERVER" "$ZABBIX_SERVER"
    [ -n "$ZABBIX_HOST" ] && update_config "ZABBIX_HOST" "$ZABBIX_HOST"
    [ -n "$ZABBIX_URL" ] && update_config "ZABBIX_URL" "$ZABBIX_URL"
    [ -n "$USE_ZABBIX_SENDER" ] && update_config "USE_ZABBIX_SENDER" "$USE_ZABBIX_SENDER"

    # Our UserParameter scripts (multiflexi-cli, multiflexi-zabbix-lld, ...)
    # run as the zabbix agent's own user, but $CONFIG_DIR is locked down to
    # multiflexi:www-data 0750 (it holds DB_PASSWORD/ENCRYPTION_MASTER_KEY),
    # so that user can't otherwise even traverse into it. Grant read-only
    # access via ACL rather than widening the directory or adding zabbix to
    # an unrelated group. Safe to re-run on every upgrade.
    if getent passwd zabbix > /dev/null 2>&1 && [ -d "$CONFIG_DIR" ] && command -v setfacl > /dev/null 2>&1; then
        setfacl -m u:zabbix:r-x "$CONFIG_DIR" || true
        [ -f "$CONFIG_FILE" ] && setfacl -m u:zabbix:r-- "$CONFIG_FILE" || true
    fi
fi

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    if deb-systemd-helper --quiet was-enabled 'zabbix-agent2.service' >/dev/null 2>&1; then
        deb-systemd-helper reload 'zabbix-agent2.service' >/dev/null 2>&1 || true
    fi
fi

#DEBHELPER#
